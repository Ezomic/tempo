[Unit]
Description=Tempo Garmin sync sidecar
After=network.target

[Service]
Type=exec
User=tempo-sidecar
Group=tempo-sidecar
WorkingDirectory=/opt/tempo-sidecar
# Holds only TEMPO_SIDECAR_SECRET (and optional TEMPO_SIDECAR_THROTTLE); chmod 600, owned by tempo-sidecar.
EnvironmentFile=/etc/tempo-sidecar/env
# Bound to localhost only: nothing off-box can reach it.
ExecStart=/opt/tempo-sidecar/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8790
Restart=on-failure
RestartSec=5

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The only path the service must write is the Garmin token store.
ReadWritePaths=/opt/tempo-sidecar/tokens
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
